{
  "name": "rustdoc-to-fumadocs",
  "version": "0.5.1",
  "description": "Generate linked Fumadocs MDX API references from rustdoc JSON for Rust crates and Cargo workspaces.",
  "keywords": [
    "rustdoc",
    "fumadocs",
    "mdx",
    "documentation",
    "rust",
    "typescript",
    "api-docs",
    "converter",
    "rustdoc-json",
    "cargo-workspace",
    "static-site-generator"
  ],
  "author": "Biostochastics",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biostochastics/rustdoc-to-fumadocs.git"
  },
  "homepage": "https://github.com/biostochastics/rustdoc-to-fumadocs#readme",
  "bugs": {
    "url": "https://github.com/biostochastics/rustdoc-to-fumadocs/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rustdoc-to-fumadocs": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src",
    "INSTALLATION.md",
    "EXTERNAL_LICENSES.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "generate": "tsx src/cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "husky",
    "prepack": "npm run build",
    "test:rust": "bash scripts/test-rust.sh",
    "test:fumadocs": "bash scripts/test-fumadocs.sh",
    "test:crates": "bash scripts/test-real-crates.sh"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-gfm": "^3.0.0",
    "parse5": "^8.1.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@mdx-js/mdx": "^3.1.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "sideEffects": false
}
