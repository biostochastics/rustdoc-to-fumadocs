+++ b/measure-library.mjs
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { performance } from "node:perf_hooks";
+
+const [operation, variant, input] = process.argv.slice(2);
+const { RustdocGenerator } = await import(`./${variant}/generator.js`);
+const { validateRustdocJson } = await import(`./${variant}/validation.js`);
+function load() {
+  return validateRustdocJson(JSON.parse(readFileSync(input, "utf8"))).crate;
+}
+const generator = new RustdocGenerator(load(), {
+  output: ".",
+  baseUrl: "/docs/api",
+  onWarning() {},
+});
+const hash = createHash("sha256");
+if (operation === "fields") {
+  const plan = generator.buildPlan();
+  generator.buildMemberUrls(plan);
+  const page = plan.pages.find((candidate) => candidate.name === "TestStruct");
+  const ids = generator.fieldIds(page.item);
+  const start = performance.now();
+  for (const id of ids) {
+    const url = generator.fragmentUrl(page, "structfield." + generator.getItem(id).name);
+    assert.equal(url, page.url + "#fields");
+    hash.update(url);
+  }
+  console.log({ lookup_ms: performance.now() - start, count: ids.length, sha256: hash.digest("hex") });
+} else {
+  assert.equal(operation, "render");
+  let count = 0;
+  let bytes = 0;
+  function consume({ path, content }) {
+    count++;
+    bytes += Buffer.byteLength(content);
+    hash.update(path).update("\0").update(content).update("\0");
+  }
+  global.gc();
+  const start = performance.now();
+  let files;
+  if (variant === "lean") generator.generate({ push: consume });
+  else {
+    files = generator.generate();
+    files.forEach(consume);
+  }
+  const render_consume_ms = performance.now() - start;
+  global.gc();
+  const live_heap_mib = process.memoryUsage().heapUsed / 1048576;
+  // Keep the same generator state and any returned file array live through collection.
+  assert.ok(generator.crate.index);
+  if (files) assert.equal(files.length, count);
+  console.log({ render_consume_ms, live_heap_mib, count, bytes, sha256: hash.digest("hex") });
+}
